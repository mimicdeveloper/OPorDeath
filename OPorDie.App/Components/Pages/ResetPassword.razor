@page "/reset-password"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserMgr
@inject NavigationManager Nav

<h1>🔑 Reset Password</h1>

<div class="panel" style="max-width:420px">
    @if (done)
    {
        <p style="color:#6bff9e">✅ Password reset! You can now <a href="/login">log in</a> with your new password.</p>
    }
    else if (invalid)
    {
        <p style="color:#ff6b6b">This reset link is invalid or has expired.</p>
        <p class="muted"><a href="/forgot-password">Request a new one</a></p>
    }
    else
    {
        @if (!string.IsNullOrEmpty(error))
        {
            <p style="color:#ff6b6b">@error</p>
        }
        <div style="display:flex; flex-direction:column; gap:.8rem">
            <div>
                <label class="muted" style="font-size:.85rem">New Password</label>
                <input type="password" @bind="password" placeholder="Min 8 chars, include a symbol" style="width:100%; margin-top:.25rem" />
            </div>
            <div>
                <label class="muted" style="font-size:.85rem">Confirm New Password</label>
                <input type="password" @bind="confirm" placeholder="Repeat password" style="width:100%; margin-top:.25rem"
                       @onkeydown="@(async e => { if (e.Key == "Enter") await Submit(); })" />
            </div>
            <button @onclick="Submit" disabled="@busy">@(busy ? "Resetting…" : "Set New Password")</button>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery] private string? userId { get; set; }
    [SupplyParameterFromQuery] private string? token { get; set; }

    private string password = "", confirm = "", error = "";
    private bool busy, done, invalid;

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(userId) || string.IsNullOrEmpty(token))
            invalid = true;
    }

    private async Task Submit()
    {
        error = "";
        if (string.IsNullOrWhiteSpace(password) || string.IsNullOrWhiteSpace(confirm))
        {
            error = "Please fill in both fields.";
            return;
        }
        if (password != confirm)
        {
            error = "Passwords do not match.";
            return;
        }

        busy = true;
        var user = await UserMgr.FindByIdAsync(userId!);
        if (user is null) { invalid = true; busy = false; return; }

        var result = await UserMgr.ResetPasswordAsync(user, token!, password);
        if (result.Succeeded)
        {
            done = true;
        }
        else
        {
            error = string.Join(" ", result.Errors.Select(e => e.Description));
        }
        busy = false;
    }
}
