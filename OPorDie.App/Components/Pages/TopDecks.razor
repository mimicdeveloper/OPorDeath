    // ── State ──────────────────────────────────────────────────────────────────
    private DeckEntry? expanded;
    private bool busy;
    private string deckMsg = "";
    private string rawList = "", importName = "Imported Deck", status = "";
    private List<(string number, int qty)> parsed = new();

    private void Toggle(DeckEntry d)
    {
        expanded = expanded == d ? null : d;
        deckMsg = "";
    }

    // ── Save a meta deck to My Decks ──────────────────────────────────────────
    private async Task SaveDeck(DeckEntry d)
    {
        busy = true; deckMsg = "";
        var deck = new Deck
        {
            Name = d.Leader,
            LeaderCardNumber = d.Cards[0].number,
            LeaderName = d.Leader,
            Cards = d.Cards.Skip(1).Select(c => new DeckCard
            {
                CardNumber = c.number, CardName = c.number, Quantity = c.qty
            }).ToList()
        };
        Db.Decks.Add(deck);
        await Db.SaveChangesAsync();
        deckMsg = $"✅ Saved to My Decks!";
        busy = false;
    }

    // ── Add all cards in a meta deck to the collection ────────────────────────
    private async Task AddToCollection(DeckEntry d)
    {
        busy = true; deckMsg = "";
        await AddCardsToCollection(d.Cards);
        deckMsg = "✅ Added to Collection!";
        busy = false;
    }

    // ── Paste-import helpers ───────────────────────────────────────────────────
    private void Parse()
    {
        parsed.Clear();
        var numRe = new Regex(@"\b([A-Z]{1,4}\d{2}-\d{3}|P-\d{3})\b", RegexOptions.IgnoreCase);
        foreach (var line in rawList.Split('\n'))
        {
            var m = numRe.Match(line);
            if (!m.Success) continue;
            var number = m.Value.ToUpperInvariant();
            var qtyMatch = Regex.Match(line, @"(\d+)\s*[xX]?\b");
            int qty = 1;
            if (qtyMatch.Success && int.TryParse(qtyMatch.Groups[1].Value, out var q) && q is > 0 and <= 4)
                qty = q;
            parsed.Add((number, qty));
        }
        status = parsed.Count == 0 ? "No card numbers found." : $"Parsed {parsed.Count} entries.";
    }

    private async Task SaveImported()
    {
        if (parsed.Count == 0) return;
        var deck = new Deck
        {
            Name = string.IsNullOrWhiteSpace(importName) ? "Imported Deck" : importName,
            LeaderCardNumber = parsed[0].number,
            LeaderName = parsed[0].number,
            Cards = parsed.Skip(1).Select(p => new DeckCard
            {
                CardNumber = p.number, CardName = p.number, Quantity = p.qty
            }).ToList()
        };
        Db.Decks.Add(deck);
        await Db.SaveChangesAsync();
        status = $"✅ Saved '{deck.Name}'.";
    }

    private async Task AddParsedToCollection()
    {
        if (parsed.Count == 0) return;
        await AddCardsToCollection(parsed);
        status = "✅ Added to Collection!";
    }

    // ── Shared collection-add logic ────────────────────────────────────────────
    private async Task AddCardsToCollection(IEnumerable<(string number, int qty)> cards)
    {
        var numbers = cards.Select(c => c.number).ToList();
        var dbCards = await Db.Cards.Where(c => numbers.Contains(c.CardNumber)).ToListAsync();
        var existing = await Db.CollectionItems
            .Where(ci => dbCards.Select(c => c.Id).Contains(ci.CardId))
            .ToListAsync();

        foreach (var (number, qty) in cards)
        {
            var card = dbCards.FirstOrDefault(c => c.CardNumber == number);
            if (card is null) continue;
            var item = existing.FirstOrDefault(ci => ci.CardId == card.Id);
            if (item is null)
                Db.CollectionItems.Add(new CollectionItem { CardId = card.Id, Quantity = qty });
            else
                item.Quantity += qty;
        }
        await Db.SaveChangesAsync();
    }
}
