@page "/topdecks"
@rendermode InteractiveServer
@using System.Text.RegularExpressions
@inject AppDbContext Db

<h1>Top Decks & Meta</h1>
<p class="muted">
    Current OP-16 format snapshot (June 2026). Click any deck row to view the full list,
    save it to My Decks, or add all cards to your collection.
</p>

<table>
    <thead><tr><th>Tier</th><th>Leader</th><th>Colors</th><th>Recent wins*</th><th></th></tr></thead>
    <tbody>
        @foreach (var d in meta)
        {
            <tr style="cursor:pointer" @onclick="() => Toggle(d)" title="Click to expand decklist">
                <td><span class="rarity @d.TierClass">@d.Tier</span></td>
                <td><strong>@d.Leader</strong></td>
                <td>@d.Colors</td>
                <td>@d.Wins</td>
                <td style="color:var(--gold)">@(expanded == d ? "▲" : "▼")</td>
            </tr>
            @if (expanded == d)
            {
                <tr>
                    <td colspan="5" style="padding:1rem; background:#0f0b14">
                        <div style="display:flex; gap:.6rem; flex-wrap:wrap; align-items:center; margin-bottom:.8rem">
                            <span class="muted" style="font-size:.9rem">@d.Cards.Sum(c => c.qty) cards</span>
                            <button title="Save this decklist to My Decks so you can edit and playtest it"
                                    @onclick="() => SaveDeck(d)" disabled="@busy">
                                💾 Save to My Decks
                            </button>
                            <button class="secondary"
                                    title="Add every card in this list to your Collection (up to the quantities listed)"
                                    @onclick="() => AddToCollection(d)" disabled="@busy">
                                📦 Add all to Collection
                            </button>
                            @if (!string.IsNullOrEmpty(deckMsg))
                            {
                                <span class="muted">@deckMsg</span>
                            }
                        </div>
                        <div class="pack-grid" style="grid-template-columns:repeat(auto-fill,minmax(100px,1fr))">
                            @foreach (var c in d.Cards)
                            {
                                <div class="pack-card" title="@c.number — @c.qty copy/copies in this list">
                                    <img src="@CardImages.Url(c.number)" alt="@c.number"
                                         style="width:100%; border-radius:6px" loading="lazy" />
                                    <div class="num">@c.number</div>
                                    <div class="nm">@c.qty×</div>
                                </div>
                            }
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
<p class="muted" style="font-size:.8rem">*Tournament wins, ~May 25–June 9 window.</p>

<p>
    Live decklists & results:
    <a href="https://onepiece.limitlesstcg.com/decks" target="_blank" title="Full tournament results and top lists">Limitless</a> ·
    <a href="https://www.optcg.one/decklists" target="_blank">optcg.one</a> ·
    <a href="https://opmetagame.com/tournaments/" target="_blank">opmetagame</a> ·
    <a href="https://onepiece.gg/tier-lists/" target="_blank">onepiece.gg</a>
</p>

<hr style="border-color:#232a33; margin:1.5rem 0" />

<h2>Import a custom decklist</h2>
<p class="muted">
    Paste a list from any of those sites. We accept lines like <code>4xOP01-016</code>,
    <code>4 OP01-016</code>, or <code>OP01-016 x4</code>. The first card is treated as the Leader.
</p>

<textarea rows="8" style="width:100%; font-family:monospace"
          placeholder="1xOP16-080&#10;4xOP09-049&#10;4xOP06-076&#10;…" @bind="rawList"></textarea>
<div style="margin:.5rem 0; display:flex; gap:.5rem; flex-wrap:wrap; align-items:center">
    <input placeholder="Deck name" @bind="importName" style="width:220px"
           title="Name for this deck in My Decks" />
    <button title="Parse the pasted list and preview the cards below" @onclick="Parse">
        🔍 Preview
    </button>
    <button title="Save the previewed list as a new deck in My Decks"
            @onclick="SaveImported" disabled="@(parsed.Count == 0)">
        💾 Save as deck
    </button>
    <button class="secondary"
            title="Add every card from the pasted list straight into your Collection"
            @onclick="AddParsedToCollection" disabled="@(parsed.Count == 0)">
        📦 Add to Collection
    </button>
    <span class="muted">@status</span>
</div>

@if (parsed.Count > 0)
{
    <p class="muted">@parsed.Sum(p => p.qty) cards parsed.</p>
    <div class="pack-grid">
        @foreach (var p in parsed)
        {
            <div class="pack-card" title="@p.number — @p.qty copy/copies">
                <img src="@CardImages.Url(p.number)" alt="@p.number"
                     style="width:100%; border-radius:6px" loading="lazy" />
                <div class="num">@p.number</div>
                <div class="nm">@p.qty×</div>
            </div>
        }
    </div>
}

