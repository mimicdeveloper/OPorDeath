@page "/topdecks"
@rendermode InteractiveServer
@using System.Text.RegularExpressions
@inject AppDbContext Db

<h1>Top Decks & Meta</h1>
<p class="muted">
    Current OP-16 format snapshot (June 2026). Click any deck row to view the full list,
    save it to My Decks, or add all cards to your collection.
</p>

<table>
    <thead><tr><th>Tier</th><th>Leader</th><th>Colors</th><th>Recent wins*</th><th></th></tr></thead>
    <tbody>
        @foreach (var d in meta)
        {
            <tr style="cursor:pointer" @onclick="() => Toggle(d)" title="Click to expand decklist">
                <td><span class="rarity @d.TierClass">@d.Tier</span></td>
                <td><strong>@d.Leader</strong></td>
                <td>@d.Colors</td>
                <td>@d.Wins</td>
                <td style="color:var(--gold)">@(expanded == d ? "▲" : "▼")</td>
            </tr>
            @if (expanded == d)
            {
                <tr>
                    <td colspan="5" style="padding:1rem; background:#0f0b14">
                        <div style="display:flex; gap:.6rem; flex-wrap:wrap; align-items:center; margin-bottom:.8rem">
                            <span class="muted" style="font-size:.9rem">
                                1 Leader · 50 cards · 10 DON!!
                            </span>
                            <button title="Save this decklist to My Decks so you can edit and playtest it"
                                    @onclick="() => SaveDeck(d)" disabled="@busy">
                                💾 Save to My Decks
                            </button>
                            <button class="secondary"
                                    title="Add every card in this list to your Collection"
                                    @onclick="() => AddToCollection(d)" disabled="@busy">
                                📦 Add all to Collection
                            </button>
                            @if (!string.IsNullOrEmpty(deckMsg)) { <span class="muted">@deckMsg</span> }
                        </div>

                        <!-- Leader -->
                        <p class="muted" style="font-size:.78rem; margin:.4rem 0 .3rem; text-transform:uppercase; letter-spacing:1px">Leader</p>
                        <div class="pack-grid" style="grid-template-columns:repeat(auto-fill,minmax(100px,1fr)); margin-bottom:.8rem">
                            <div class="pack-card" title="Leader card">
                                <img src="@CardImages.Url(d.LeaderNumber)" alt="Leader" style="width:100%; border-radius:6px" loading="lazy" />
                                <div class="num">@d.LeaderNumber</div>
                                <div class="nm">Leader</div>
                            </div>
                        </div>

                        <!-- DON!! deck -->
                        <p class="muted" style="font-size:.78rem; margin:.4rem 0 .4rem; text-transform:uppercase; letter-spacing:1px">DON!! Deck (×10)</p>
                        <div style="display:flex; gap:4px; flex-wrap:wrap; margin-bottom:.8rem">
                            @for (int i = 0; i < 10; i++)
                            {
                                <div style="width:70px; height:98px; flex-shrink:0; border-radius:6px;
                                            background:linear-gradient(135deg,#4a3800,#c09000,#e9b84c,#c09000,#4a3800);
                                            border:2px solid #e9b84c;
                                            display:flex; flex-direction:column; align-items:center;
                                            justify-content:center; gap:4px; position:relative; overflow:hidden">
                                    <div style="position:absolute; inset:4px; border-radius:4px;
                                                border:1px solid rgba(255,220,80,.4)"></div>
                                    <span style="font-size:1.5rem; line-height:1; filter:drop-shadow(0 0 6px #ffcc00)">⚡</span>
                                    <span style="font-size:.6rem; font-weight:900; letter-spacing:2px;
                                                 color:#fff; text-shadow:0 0 8px #ffcc00, 0 1px 3px rgba(0,0,0,.9)">DON!!</span>
                                </div>
                            }
                        </div>

                        <!-- Main deck -->
                        <p class="muted" style="font-size:.78rem; margin:.4rem 0 .3rem; text-transform:uppercase; letter-spacing:1px">Main Deck (50 cards)</p>
                        <div class="pack-grid" style="grid-template-columns:repeat(auto-fill,minmax(100px,1fr))">
                            @foreach (var c in d.Cards)
                            {
                                <div class="pack-card" title="@c.number — @c.qty copy/copies">
                                    <img src="@CardImages.Url(c.number)" alt="@c.number" style="width:100%; border-radius:6px" loading="lazy" />
                                    <div class="num">@c.number</div>
                                    <div class="nm">@c.qty×</div>
                                </div>
                            }
                        </div>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
<p class="muted" style="font-size:.8rem">*Tournament wins, ~May 25–June 9 window.</p>

<p>
    Live decklists & results:
    <a href="https://onepiece.limitlesstcg.com/decks" target="_blank">Limitless</a> ·
    <a href="https://www.optcg.one/decklists" target="_blank">optcg.one</a> ·
    <a href="https://opmetagame.com/tournaments/" target="_blank">opmetagame</a> ·
    <a href="https://onepiece.gg/tier-lists/" target="_blank">onepiece.gg</a>
</p>

<hr style="border-color:#232a33; margin:1.5rem 0" />

<h2>Import a custom decklist</h2>
<p class="muted">
    Paste a list from any of those sites. Lines like <code>4xOP01-016</code>, <code>4 OP01-016</code>, or <code>OP01-016 x4</code>. First card = Leader.
</p>
<textarea rows="8" style="width:100%; font-family:monospace"
          placeholder="1xOP16-080&#10;4xOP09-049&#10;4xOP06-076&#10;…" @bind="rawList"></textarea>
<div style="margin:.5rem 0; display:flex; gap:.5rem; flex-wrap:wrap; align-items:center">
    <input placeholder="Deck name" @bind="importName" style="width:220px" title="Name for this deck" />
    <button title="Parse the list and preview cards below" @onclick="Parse">🔍 Preview</button>
    <button title="Save previewed list as a new deck" @onclick="SaveImported" disabled="@(parsed.Count == 0)">💾 Save as deck</button>
    <button class="secondary" title="Add all parsed cards to your Collection" @onclick="AddParsedToCollection" disabled="@(parsed.Count == 0)">📦 Add to Collection</button>
    <span class="muted">@status</span>
</div>
@if (parsed.Count > 0)
{
    <p class="muted">@parsed.Sum(p => p.qty) cards parsed.</p>
    <div class="pack-grid">
        @foreach (var p in parsed)
        {
            <div class="pack-card" title="@p.number — @p.qty copy/copies">
                <img src="@CardImages.Url(p.number)" alt="@p.number" style="width:100%; border-radius:6px" loading="lazy" />
                <div class="num">@p.number</div>
                <div class="nm">@p.qty×</div>
            </div>
        }
    </div>
}

