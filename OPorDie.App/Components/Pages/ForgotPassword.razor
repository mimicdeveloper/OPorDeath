@page "/forgot-password"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Identity.UI.Services
@inject UserManager<IdentityUser> UserMgr
@inject IEmailSender EmailSender
@inject NavigationManager Nav

<h1>🔓 Forgot Password</h1>

<div class="panel" style="max-width:420px">
    @if (sent)
    {
        <p style="color:#6bff9e">
            ✅ If that email has an account, a password reset link has been sent. Check your inbox.
        </p>
        <p class="muted" style="font-size:.85rem">Didn't get it? Check your spam folder or <a href="/forgot-password">try again</a>.</p>
    }
    else
    {
        @if (!string.IsNullOrEmpty(error))
        {
            <p style="color:#ff6b6b">@error</p>
        }
        <p class="muted" style="margin-top:0">Enter your email and we'll send you a reset link.</p>
        <div style="display:flex; flex-direction:column; gap:.8rem">
            <div>
                <label class="muted" style="font-size:.85rem">Email address</label>
                <input type="email" @bind="email" placeholder="your@email.com" style="width:100%; margin-top:.25rem"
                       @onkeydown="@(async e => { if (e.Key == "Enter") await Submit(); })" />
            </div>
            <button @onclick="Submit" disabled="@busy">@(busy ? "Sending…" : "Send Reset Link")</button>
            <p class="muted" style="font-size:.85rem; margin:0">
                Remembered it? <a href="/login">Back to login</a>
            </p>
        </div>
    }
</div>

@code {
    private string email = "", error = "";
    private bool busy, sent;

    private async Task Submit()
    {
        error = "";
        if (string.IsNullOrWhiteSpace(email)) { error = "Please enter your email."; return; }

        busy = true;
        var user = await UserMgr.FindByEmailAsync(email);

        // Always show success to avoid leaking which emails are registered
        if (user is not null && await UserMgr.IsEmailConfirmedAsync(user))
        {
            var token = await UserMgr.GeneratePasswordResetTokenAsync(user);
            var link = Nav.ToAbsoluteUri(
                $"/reset-password?userId={Uri.EscapeDataString(user.Id)}&token={Uri.EscapeDataString(token)}");

            await EmailSender.SendEmailAsync(email, "Reset your OP or Death password",
                $"<p>Hey {user.UserName},</p>" +
                $"<p>Click below to reset your password. This link expires in 24 hours.</p>" +
                $"<p><a href='{link}' style='font-size:1.1rem'>Reset Password</a></p>" +
                $"<p style='color:#888; font-size:.85rem'>If you didn't request this, you can safely ignore this email.</p>");
        }

        sent = true;
        busy = false;
    }
}
