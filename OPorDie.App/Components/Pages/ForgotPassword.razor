@page "/forgot-password"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Identity.UI.Services
@inject UserManager<IdentityUser> UserMgr
@inject IEmailSender EmailSender
@inject CodeStore Codes
@inject NavigationManager Nav

<h1>🔓 Forgot Password</h1>

<div class="panel" style="max-width:420px">
    @if (!string.IsNullOrEmpty(error))
    {
        <p style="color:#ff6b6b; margin-top:0">@error</p>
    }

    @if (step == 1)
    {
        <p class="muted" style="margin-top:0">Enter your email and we'll send a 6-digit reset code.</p>
        <div style="display:flex; flex-direction:column; gap:.9rem">
            <div>
                <label class="muted" style="font-size:.85rem; display:block; margin-bottom:.25rem">Email address</label>
                <input type="email" @bind="email" @bind:event="oninput" placeholder="your@email.com" style="width:100%"
                       @onkeydown="OnKey" />
            </div>
            <button @onclick="SendCode" disabled="@busy">@(busy ? "Sending…" : "Send Code")</button>
            <a href="/login" style="font-size:.85rem">Back to login</a>
        </div>
    }
    else if (step == 2)
    {
        <p class="muted" style="margin-top:0">
            Enter the 6-digit code sent to <strong>@email</strong>.
        </p>
        <div style="display:flex; flex-direction:column; gap:.9rem">
            <div>
                <label class="muted" style="font-size:.85rem; display:block; margin-bottom:.25rem">Reset Code</label>
                <input @bind="code" @bind:event="oninput" placeholder="123456" maxlength="6"
                       style="width:100%; font-size:1.4rem; letter-spacing:.3rem; text-align:center"
                       @onkeydown="OnCodeKey" />
            </div>
            <button @onclick="VerifyCode" disabled="@busy">@(busy ? "Checking…" : "Verify Code")</button>
            <button class="secondary" @onclick="SendCode" disabled="@busy">Resend code</button>
        </div>
    }
    else
    {
        <p class="muted" style="margin-top:0">Enter your new password.</p>
        <div style="display:flex; flex-direction:column; gap:.9rem">
            <div>
                <label class="muted" style="font-size:.85rem; display:block; margin-bottom:.25rem">New Password</label>
                <input type="password" @bind="password" @bind:event="oninput" placeholder="Min 8 chars, include a symbol" style="width:100%" />
            </div>
            <div>
                <label class="muted" style="font-size:.85rem; display:block; margin-bottom:.25rem">Confirm New Password</label>
                <input type="password" @bind="confirm" @bind:event="oninput" placeholder="Repeat password" style="width:100%"
                       @onkeydown="OnResetKey" />
            </div>
            <button @onclick="DoReset" disabled="@busy">@(busy ? "Resetting…" : "Set New Password")</button>
        </div>
    }
</div>

@code {
    private string email = "", code = "", password = "", confirm = "", error = "";
    private bool busy;
    private int step = 1;
    private IdentityUser? foundUser;

    private async Task OnKey(KeyboardEventArgs e) { if (e.Key == "Enter") await SendCode(); }
    private async Task OnCodeKey(KeyboardEventArgs e) { if (e.Key == "Enter") await VerifyCode(); }
    private async Task OnResetKey(KeyboardEventArgs e) { if (e.Key == "Enter") await DoReset(); }

    private async Task SendCode()
    {
        error = "";
        if (string.IsNullOrWhiteSpace(email)) { error = "Please enter your email."; return; }

        busy = true;
        var user = await UserMgr.FindByEmailAsync(email);

        if (user is not null)
        {
            var c = Codes.Generate($"reset:{email}");
            try { await EmailSender.SendEmailAsync(email, "Your OP or Death password reset code",
                $"<div style='font-family:sans-serif'>" +
                $"<h2>Password Reset ☠</h2>" +
                $"<p>Your reset code is:</p>" +
                $"<p style='font-size:2.5rem; font-weight:bold; letter-spacing:.4rem; color:#e9b84c'>{c}</p>" +
                $"<p style='color:#888; font-size:.85rem'>This code expires in 15 minutes. If you didn't request this, ignore this email.</p>" +
                $"</div>");
            } catch { /* always advance to step 2 */ }
        }

        // Always advance to step 2 to avoid leaking which emails are registered
        step = 2;
        busy = false;
    }

    private async Task VerifyCode()
    {
        error = "";
        if (string.IsNullOrWhiteSpace(code)) { error = "Enter the code from your email."; return; }

        busy = true;
        if (!Codes.Validate($"reset:{email}", code.Trim()))
        { error = "Incorrect or expired code. Try again or resend."; busy = false; return; }

        foundUser = await UserMgr.FindByEmailAsync(email);
        if (foundUser is null) { error = "No account found for that email."; busy = false; return; }

        step = 3;
        busy = false;
    }

    private async Task DoReset()
    {
        error = "";
        if (string.IsNullOrWhiteSpace(password) || string.IsNullOrWhiteSpace(confirm))
        { error = "Please fill in both fields."; return; }
        if (password != confirm) { error = "Passwords do not match."; return; }

        busy = true;
        var token = await UserMgr.GeneratePasswordResetTokenAsync(foundUser!);
        var result = await UserMgr.ResetPasswordAsync(foundUser!, token, password);

        if (result.Succeeded)
            Nav.NavigateTo("/login?reset=1", forceLoad: true);
        else
            error = string.Join(" ", result.Errors.Select(e => e.Description));

        busy = false;
    }
}
