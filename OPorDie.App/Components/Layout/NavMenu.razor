@rendermode InteractiveServer

<nav class="sidebar @(open ? "mob-open" : "")">
    <div class="brand">
        <img src="logo.svg" alt="OP or Death" class="brand-logo" />
        <span class="brand-text">OP or<br/>Death</span>
        <span class="brand-sub">☠ ONE PIECE TCG ☠</span>
        <button class="hamburger" @onclick="Toggle" aria-label="Menu">
            @if (open) { <span>✕</span> } else { <span>☰</span> }
        </button>
    </div>

    <div class="nav-links">
        <NavLink class="nav-item" href="" Match="NavLinkMatch.All" @onclick="Close">🏠 Dashboard</NavLink>
        <NavLink class="nav-item" href="cards" @onclick="Close">🃏 Browse Cards</NavLink>
        <NavLink class="nav-item" href="deckbuilder" @onclick="Close">🛠 Deck Builder</NavLink>
        <NavLink class="nav-item" href="mydecks" @onclick="Close">📁 My Decks</NavLink>
        <NavLink class="nav-item" href="topdecks" @onclick="Close">🏆 Top Decks</NavLink>
        <NavLink class="nav-item" href="learn" @onclick="Close">🎓 Learn to Play</NavLink>
        <NavLink class="nav-item" href="playtest" @onclick="Close">⚔️ Playtest</NavLink>
        <NavLink class="nav-item" href="sim" @onclick="Close">🎴 Pack Simulator</NavLink>
        <NavLink class="nav-item" href="collection" @onclick="Close">📚 My Collection</NavLink>
        <NavLink class="nav-item" href="stores" @onclick="Close">🗺️ Stores & Events</NavLink>
        <NavLink class="nav-item" href="alerts" @onclick="Close">🔔 Price Alerts</NavLink>
        <NavLink class="nav-item" href="about" @onclick="Close">☠ About / Support</NavLink>

        <div class="nav-divider">Account</div>
        <AuthorizeView>
            <Authorized Context="authContext">
                <span class="nav-item" style="cursor:default">👤 @authContext.User.Identity?.Name</span>
                <form method="post" action="/account/logout" style="margin:0">
                    <AntiforgeryToken />
                    <button type="submit" class="nav-logout">🚪 Logout</button>
                </form>
            </Authorized>
            <NotAuthorized>
                <NavLink class="nav-item" href="login" @onclick="Close">🔑 Login</NavLink>
                <NavLink class="nav-item" href="register" @onclick="Close">📝 Register</NavLink>
            </NotAuthorized>
        </AuthorizeView>

        <a class="nav-item nav-ext" href="/swagger" target="_blank">🛠 API (Swagger)</a>
    </div>
</nav>

@code {
    private bool open;
    private void Toggle() => open = !open;
    private void Close() => open = false;
}
